backend/src/certifi/
backend/src/certifi-*.dist-info/
backend/src/charset_normalizer/
backend/src/charset_normalizer-*.dist-info/
backend/src/idna/
backend/src/idna-*.dist-info/
backend/src/requests/
backend/src/requests-*.dist-info/
backend/src/urllib3/
backend/src/urllib3-*.dist-info/
backend/src/*.so
backend/src/requirements.txt

